<?xml version="1.0" encoding="utf-8"?>
<!-- Key filtering depends only on flagRequestFilterKeyEvents and canRequestFilterKeyEvents.
     typeWindowStateChanged is declared here (not only added at runtime) so Fire OS delivers the window
     transitions stock_home_redirect needs to catch com.amazon.tv.launcher's home screen.
     canRetrieveWindowContent: on Fire OS 7, Settings is a tab of that same home activity, so HomeKeyService
     looks for the Settings cards before it redirects (only right after a Settings screen). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/home_key_description" />
