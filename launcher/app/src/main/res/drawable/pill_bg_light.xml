<?xml version="1.0" encoding="utf-8"?>
<!-- pill_bg for the light header theme (HeaderTheme): a light frosted pill, and a dark one when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F21C1C1E" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF2F8FE0" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#B3FFFFFF" android:endColor="#8CFFFFFF" />
            <stroke android:width="1dp" android:color="#291C1C1E" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
